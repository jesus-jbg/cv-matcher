# Copia este archivo como ".env" y rellena los valores.

# --- Servidor ---
PORT=3000
# Dirección pública de la app (se usa en los enlaces de los correos)
APP_URL=http://localhost:3000

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cv_matcher_db
DB_PORT=3306
# Bases de datos en la nube: DB_SSL=true
DB_SSL=false

# --- Seguridad ---
# Obligatorio. Mínimo 16 caracteres, aleatorio. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Correo para recuperar contraseña (opcional) ---
# Si SMTP_HOST está vacío, el enlace de recuperación se escribe en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CV Matcher <tucorreo@ejemplo.com>"

# --- Importación de CV mejorada con IA (opcional) ---
# Sin esta clave la importación usa un analizador básico sin IA.
ANTHROPIC_API_KEY=

# --- Modo demo público (opcional) ---
# DEMO_MODE=true muestra el botón «Probar la demo» (cuenta temporal con datos de ejemplo).
DEMO_MODE=false
# REGISTRATION_OPEN=false cierra el registro de cuentas nuevas.
REGISTRATION_OPEN=true
# Detrás de un proxy (Render, Railway...): TRUST_PROXY=1
TRUST_PROXY=

# --- Textos legales (/privacidad, /aviso-legal, /terminos) ---
# LEGAL_EMAIL es obligatorio al publicar la app: es el contacto que aparece en los textos.
LEGAL_NAME="Jesús Bejarano González"
LEGAL_EMAIL=
LEGAL_PLACE="Sevilla, España"
# Proveedores donde se alojan la app y la base de datos (texto libre), por ejemplo: "Render y Aiven"
LEGAL_HOSTING=
